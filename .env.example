VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Opcional: só ativa o Pixel do Meta (Facebook/Instagram Ads) se for definido.
VITE_META_PIXEL_ID=

# Segredos de servidor (NUNCA usar prefixo VITE_ nestes dois — não podem ir para o navegador).
